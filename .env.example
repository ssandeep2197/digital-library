# --- Server ---
PORT=3000
# BASE_URL=https://library.example.com   (defaults to http://localhost:$PORT)
LIBRARY_NAME=Digital Library
# Dashboard sign-in. Required in production; unset = no login (development only).
ADMIN_USER=
ADMIN_PASSWORD=
# Signs session cookies; at least 32 characters in production (openssl rand -hex 32).
JWT_SECRET=
SESSION_TTL_HOURS=12

# --- MySQL (defaults match docker-compose.yml's mysql service on host port 3307) ---
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=library
DB_PASSWORD=library
DB_NAME=digital_library

# --- Lending policy ---
LOAN_DAYS=14
MAX_LOANS=5
MAX_RENEWALS=2
HOLD_DAYS=3
FINE_PER_DAY_CENTS=25
MAX_FINE_CENTS=1000
BLOCK_AT_FINE_CENTS=500

# --- Reminders & jobs ---
DUE_SOON_HOURS=24
OVERDUE_REPEAT_DAYS=3
SCHEDULER_INTERVAL_SECONDS=300
DISPATCH_INTERVAL_SECONDS=5
DISPATCH_MAX_ATTEMPTS=5
DISPATCH_BACKOFF_SECONDS=60

# --- Email (unset SMTP_HOST = simulated, logged to console) ---
MAIL_FROM=Digital Library <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# --- SMS via Twilio (unset = simulated, logged to console) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
